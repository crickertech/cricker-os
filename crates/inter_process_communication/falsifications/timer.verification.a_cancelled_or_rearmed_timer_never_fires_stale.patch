     /// was armed (never armed, already fired, or already cancelled). A caller that gets `false`
     /// back knows the signal, if any, has already been sent.
     pub fn cancel(&mut self) -> bool {
-        self.armed.take().is_some()
+        self.armed.is_some()
     }
 
