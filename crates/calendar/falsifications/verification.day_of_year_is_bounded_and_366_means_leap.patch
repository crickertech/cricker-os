Falsifies `calendar::verification::day_of_year_is_bounded_and_366_means_leap`.

The defect: `Civil::day_of_year` saturates at 365, so 31 December of a leap year reports the same day as 30
December.

Expected to fail: the harness's `assert_eq!(doy == 366, is_leap_year(y) && m == 12 && d == 31)`.

diff --git a/crates/calendar/src/lib.rs b/crates/calendar/src/lib.rs
index 332ce0020..4832fdd8c 100644
--- a/crates/calendar/src/lib.rs
+++ b/crates/calendar/src/lib.rs
@@ -420,3 +420,6 @@ impl Civil {
         let jan1 = days_from_civil(self.year, 1, 1);
-        (self.days_since_epoch() - jan1 + 1) as u16
+        {
+            let d = self.days_since_epoch() - jan1 + 1;
+            (if d > 365 { 365 } else { d }) as u16
+        }
     }
