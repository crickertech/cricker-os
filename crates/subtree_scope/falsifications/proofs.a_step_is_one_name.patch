 /// way down a tree is a name, so this is what keeps a path from going up or sideways.
 pub fn is_name(c: &[u8]) -> bool {
-    !c.is_empty() && c != b"." && c != b".." && !c.contains(&b'/') && !c.contains(&0)
+    !c.is_empty() && c != b"." && !c.contains(&b'/') && !c.contains(&0)
 }
 
