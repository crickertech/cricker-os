#!/bin/sh
#
# Report progress against the user journeys in design/journeys/ (index: README.md, one file per
# journey), reading each journey's steps against the milestone blocks in design/roadmap/ and the
# index in design/decisions/README.md, the same records script/roadmap and script/decisions already
# treat as ground truth. The roadmap half was an index table too until 2026-09-21, when calef
# retired it; the blocks it was generated from are read directly now, which is one file open per
# milestone instead of one, and the only shape a milestone's status has ever had that cannot go
# stale.
#
# Why this exists: a milestone answers "is this piece of work done"; a journey answers "could a
# person actually do the whole thing today, start to finish". No single milestone was blocking the
# first journey tracked here (boot to a login prompt, into `swish`, to editing a file with `kilo`)
# when it was asked about 2026-08-26, and scanning the roadmap milestone by milestone did not surface
# the gap that tracing the story end to end found (milestone 177). This is the mechanism that
# question deserves, rather than a one-off trace repeated by hand each time someone asks it again.
#
# A journey has no status field of its own; design/journeys/README.md explains why (the same reason
# script/roadmap's Built-date check and script/lint's counted-claims checks exist: a hand-written
# number nobody re-derives drifts the moment reality moves under it). Everything printed here is
# computed fresh from the two records, every run.
#
# With no arguments, lists every journey with a one-line rollup. Given a journey's number, slug, or
# filename (with or without `.md`), prints that journey's full step-by-step detail. `--check`
# validates that every journey file's table rows parse, that every filename's number agrees with its
# own H1, and that every milestone and decision a step cites exists in its index, and exits non-zero
# on a problem, which is what a gate wants.
#
# Name: recorded (DECISIONS §134's split of the `script/` family, and design/journeys/README.md
# for the stem). Deliberately the third instance of the `script/roadmap` and `script/decisions`
# pattern, and §134 later wrote that pattern down: a script that reports takes a noun, and the
# noun is the record it reads. Here that record is `design/journeys/`, indexed by its own README,
# so the name is fixed by the directory rather than chosen. no architect has ratified it.

set -e

ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"

exec python3 - "$ROOT" "${1:-}" <<'PY'
import os
import re
import sys

root, mode = sys.argv[1], sys.argv[2]
# Milestone 596 (the roadmap blocks get frontmatter too): a block's status is read through helpers/roadmap_block.py, which knows the
# frontmatter form and the prose form older revisions carry.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(root, "helpers"))
import roadmap_block                                                        # noqa: E402
jd = os.path.join(root, "design", "journeys")
rd = os.path.join(root, "design", "roadmap")
dd = os.path.join(root, "design", "decisions")

problems = []


def load_index(path, row_re):
    try:
        text = open(path).read()
    except FileNotFoundError:
        print(f"journeys: {path} not found", file=sys.stderr)
        sys.exit(1)
    out = {}
    for line in text.split("\n"):
        m = row_re.match(line)
        if m:
            out[int(m.group(1))] = m.group(2)
    return out


# The decision index's row shape, which script/decisions parses too.
DECISION_ROW = re.compile(r"^\| (\d+) \| ([A-Z][A-Z0-9 ]*[A-Z0-9]) \| \[")

# The milestone blocks, read the way script/roadmap reads them: the number is the filename's and
# the status is its frontmatter or its prose status line (helpers/roadmap_block.py reads both). A
# lettered addendum (20a) carries neither and is skipped, exactly as it is one directory over. Only the number and the status are wanted
# here, so this deliberately does not re-implement the rest of that script's validation: a block
# this cannot parse is script/roadmap --check's failure to report, not this one's.
BLOCK = re.compile(r"(\d+)-[a-z0-9][a-z0-9-]*\.md")


def load_blocks(d):
    out = {}
    try:
        names = sorted(os.listdir(d))
    except FileNotFoundError:
        print(f"journeys: {d} not found", file=sys.stderr)
        sys.exit(1)
    for fname in names:
        m = BLOCK.fullmatch(fname)
        if not m:
            continue
        lines = open(os.path.join(d, fname)).read().split("\n")
        status = roadmap_block.status_and_built("\n".join(lines))[0]
        if status:
            out[int(m.group(1))] = status
    return out


milestones = load_blocks(rd)
decisions = load_index(os.path.join(dd, "README.md"), DECISION_ROW)

STEP_ROW = re.compile(
    r"^\| *(\d+) *\| *(\d+) *\| *(\d*) *\| *(.+?) *\|$"
)

FNAME = re.compile(r"(\d+)-[a-z0-9][a-z0-9-]*\.md")

journeys = {}  # number -> (slug, title, [ (step, milestone, decision_or_None, need) ])
slugs = {}     # slug -> number, for lookup by either
for fname in sorted(os.listdir(jd)):
    if fname == "README.md" or not fname.endswith(".md"):
        continue
    m = FNAME.fullmatch(fname)
    if not m:
        problems.append(f"{fname}: not named NN-slug.md (single digits zero-padded)")
        continue
    num = int(m.group(1))
    slug = fname[:-3].split("-", 1)[1] if "-" in fname[:-3] else fname[:-3]
    if num in journeys:
        problems.append(f"journey {num} has two files")
    text = open(os.path.join(jd, fname)).read()
    lines = text.split("\n")
    title = None
    for line in lines:
        if line.startswith("# "):
            title = line[2:].strip()
            # A numbered H1 ("# N. Title") carries the number redundantly with the filename; both
            # must agree, the same rule script/roadmap enforces one directory over.
            hm = re.match(r"(\d+)\. (.+)", title)
            if hm:
                if int(hm.group(1)) != num:
                    problems.append(f"{fname}: H1 says {hm.group(1)}, filename says {num}")
                title = hm.group(2)
            break
    if title is None:
        problems.append(f"{fname}: no H1 title on its own line")
        title = slug
    steps = []
    for i, line in enumerate(lines, start=1):
        if not line.startswith("| ") or line.startswith("| step") or line.startswith("|---"):
            continue
        sm = STEP_ROW.match(line)
        if not sm:
            continue
        step, ms, dec, need = sm.groups()
        step, ms = int(step), int(ms)
        dec = int(dec) if dec else None
        if ms not in milestones:
            problems.append(f"{fname}:{i}: step {step} cites milestone {ms}, which has no block")
        if dec is not None and dec not in decisions:
            problems.append(f"{fname}:{i}: step {step} cites decision {dec}, which has no index row")
        steps.append((step, ms, dec, need))
    if not steps:
        problems.append(f"{fname}: no parseable step rows (| step | milestone | decision | need |)")
    # A retired journey is a story the project stopped telling, and it is the one thing about a
    # journey that a human must write and a tool cannot derive. It is NOT the status field
    # design/journeys/README.md refuses: that refusal is about hand-written *progress* ("70% done"),
    # which drifts because nobody re-derives it. Retirement is intent, and intent has no computable
    # source. Recorded as a `**RETIRED` marker in the file so the record and the report cannot
    # disagree, which is what happened for one run on 2026-08-30 when journey 2 was retired in prose
    # and this script kept listing it as live work.
    retired = any(line.startswith("**RETIRED") for line in lines)
    journeys[num] = (slug, title, steps, retired)
    slugs[slug] = num

if mode == "--check":
    for p in sorted(set(problems)):
        print(f"journeys: {p}", file=sys.stderr)
    if problems:
        sys.exit(1)
    print(f"journeys: {len(journeys)} journeys ({sum(1 for j in journeys.values() if j[3])} retired), "
          f"{sum(len(j[2]) for j in journeys.values())} steps, "
          f"every cited milestone and decision resolves")
    sys.exit(0)

if problems:
    for p in sorted(set(problems)):
        print(f"PROBLEM: {p}", file=sys.stderr)


def rollup(steps):
    built = sum(1 for _, ms, _, _ in steps if milestones.get(ms) == "BUILT")
    return built, len(steps)


if mode and mode != "--check":
    # Accepted forms: a bare number, a slug, or a filename (with or without .md) -- whichever a
    # reader has in hand.
    key = mode[:-3] if mode.endswith(".md") else mode
    m = re.match(r"(\d+)(?:-.*)?$", key)
    if m:
        num = int(m.group(1))
    elif key in slugs:
        num = slugs[key]
    else:
        num = None
    if num is None or num not in journeys:
        known = ", ".join(f"{n} ({s})" for n, (s, _, _) in sorted(journeys.items()))
        print(f"journeys: no journey matching {mode!r}. Known: {known}", file=sys.stderr)
        sys.exit(2)
    slug, title, steps, retired = journeys[num]
    built, total = rollup(steps)
    print(f"journey {num}: {title}")
    if retired:
        print("  RETIRED. The steps below are a record, not current intent; see the file.")
    print()
    for step, ms, dec, need in steps:
        mstatus = milestones.get(ms, "?")
        line = f"  {step}. milestone {ms:<4} {mstatus:<11} {need}"
        if dec is not None:
            line += f"  [decision {dec}: {decisions.get(dec, '?')}]"
        print(line)
    print(f"\n{built}/{total} steps on a BUILT milestone" + ("  (retired)" if retired else ""))
    sys.exit(0)

for num in sorted(journeys):
    slug, title, steps, retired = journeys[num]
    built, total = rollup(steps)
    state = "RETIRED    " if retired else f"{built}/{total} built"
    print(f"  {num:>2}  {slug:<24} {state}   {title}")
print(f"\n{len(journeys)} journeys. `script/journeys <number|slug>` for detail.")
PY
