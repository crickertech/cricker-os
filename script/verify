#!/bin/sh
# script/verify: run the machine-checked proofs (Kani) over the pure-logic crates.
#
# This is the verification thesis in practice (DECISIONS §14): the security-critical logic is proved
# for every input, not just tested on the cases we happened to write. Proof harnesses live behind
# `#[cfg(kani)]`, so an ordinary build/test never compiles them; only this script sets that cfg.
#
# Kani is not part of script/bootstrap because it pulls its own nightly toolchain and a CBMC backend
# (~a minute of download) that the kernel build does not need. This script installs it on first run,
# the same self-install pattern script/coverage uses. Not one of the canonical scripts. See
# notes/verification.md.
#
# Name: ratified 2026-08-03 (calef), retroactively and as a pattern: it runs Kani and does not say
# so, which is why swapping Kani for Verus someday would cost nothing. Introduced 2026-07-23 with
# the first capability-model proofs.

set -e
cd "$(dirname "$0")/.."

# --affected-since <base>: decide whether a change can reach the proofs at all, without proving.
#
# The proofs are a function of the harness crates and their transitive dependencies, and nothing
# else: `cargo kani -p <crate>` compiles only the crate it names and what that crate depends on.
# (This line said "never compiles the kernel" until 2026-09-24, which stopped being true when
# milestone 193 (put `kernel/src` within reach of the prover) made `kernel` a harness crate on
# 2026-08-30; the closure argument below never depended on it.) So a change confined to crates
# outside every harness crate's dependency closure provably cannot change a proof
# outcome, and the 42 minutes are spent on nothing. This mode computes that from `cargo metadata`
# rather than from a hand-kept path list, so it cannot drift as the graph changes.
#
# The posture is the same allow-list-of-inert the workflow's own comment argues for: anything this
# cannot attribute (the workspace Cargo.toml, Cargo.lock, rust-toolchain.toml, script/, vendor
# pins) runs the proofs by default, because skipping a needed proof breaks main and running an
# unneeded one only wastes minutes. The two non-crate exceptions are documentation (the predicate
# ci.yml already trusts) and workflow files other than verify.yml, which are not inputs to
# `cargo kani` (verify.yml itself runs, because a change to the proofs' own wiring should be
# exercised by that wiring).
#
# Harness crates are found by grepping for `#[kani::proof]` rather than read from the list below,
# deliberately: a crate that grows harnesses before it is added to the list still widens the
# closure, so the scope can only be more conservative than the run.
#
# Prints one line per changed file with its classification, then `verify-scope: needed` or
# `verify-scope: not-needed` as the last line, which is what .github/workflows/verify.yml reads.
if [ "$1" = "--affected-since" ]; then
	base="$2"
	if [ -z "$base" ]; then
		echo "usage: script/verify --affected-since <base-ref>" >&2
		exit 2
	fi
	exec python3 - "$base" <<'PY'
import json
import os
import re
import subprocess
import sys

base = sys.argv[1]
changed = subprocess.run(
    ["git", "diff", "--name-only", base, "HEAD"],
    capture_output=True, text=True, check=True,
).stdout.splitlines()

DOC = re.compile(r"^(notes/|design/|[A-Z_]+\.md$)")

needed, inert, todo = [], [], []
for f in changed:
    if DOC.match(f):
        inert.append((f, "documentation"))
    elif f.startswith("script/") or f.startswith("helpers/"):
        # A script/ entry point is not an input to `cargo kani`, by exactly the argument the
        # workflow-file case below already makes: the proofs are a function of the harness crates
        # and their dependency closure, and `cargo kani` never invokes script/lint, script/test or
        # any other front door. script/verify itself is the exception, because it *is* the wiring,
        # so a change to it should be exercised by it.
        #
        # `helpers/` (plural, the maintainer-only tools AGENTS.md keeps out of `script/`'s normalized
        # front door) is exactly the same case, with no exception to carry: nothing under it is ever
        # `cargo kani`'s own wiring the way `script/verify` is. Found 2026-08-26 when a `merge-drain.sh`
        # change, pure `gh`/`git`/`jq` merge-queue tooling with no path to any harness crate, ran the
        # full sharded Kani suite anyway, because this check only recognized the singular directory.
        #
        # Measured cost of not having this: on 2026-08-04 a one-line comment added to
        # script/citations ran the full 40-minute suite, because a script/ file belongs to no crate
        # and fell through to the not-attributable default below. That was the fix for a red trunk,
        # so the delay was on the critical path, and it landed the same day the repository started
        # requiring branches to be up to date before merging, which makes every re-run cost this
        # again.
        # `script/verify-riscv64` is the same exception one file over (milestone 589 (Kani can prove riscv64 from the hosts we already have)): it builds the
        # prover the riscv64 row runs under, so a change to it changes what that row proves.
        if f in ("script/verify", "script/verify-riscv64"):
            needed.append((f, "the proofs' own wiring"))
        else:
            inert.append((f, "a script/ or helpers/ entry point; not an input to cargo kani"))
    elif f.startswith(".github/"):
        if f == ".github/workflows/verify.yml":
            needed.append((f, "the proofs' own wiring"))
        else:
            inert.append((f, "workflow file; not an input to cargo kani"))
    else:
        todo.append(f)

if todo:
    try:
        meta = json.loads(subprocess.run(
            ["cargo", "metadata", "--format-version", "1", "--locked"],
            capture_output=True, text=True, check=True,
        ).stdout)
        root = meta["workspace_root"]
        # Repo-relative directory prefix per package. Packages outside the repo (registry deps)
        # have no files a diff can name; their updates arrive via Cargo.lock, which is
        # unattributable below and so runs the proofs.
        pkgs = {}
        for p in meta["packages"]:
            d = os.path.dirname(p["manifest_path"])
            rel = os.path.relpath(d, root)
            if rel == "." or rel.startswith(".."):
                continue
            pkgs[p["id"]] = (p["name"], rel + "/")

        def owner(path):
            best = None
            for pid, (_, prefix) in pkgs.items():
                if path.startswith(prefix):
                    if best is None or len(prefix) > len(pkgs[best][1]):
                        best = pid
            return best

        harness_files = subprocess.run(
            ["git", "grep", "-lF", "#[kani::proof]", "--", "*.rs"],
            capture_output=True, text=True,
        ).stdout.splitlines()
        harness_ids = {owner(f) for f in harness_files} - {None}

        edges = {n["id"]: [d["pkg"] for d in n.get("deps", [])]
                 for n in meta["resolve"]["nodes"]}
        closure, stack = set(), list(harness_ids)
        while stack:
            pid = stack.pop()
            if pid in closure:
                continue
            closure.add(pid)
            stack.extend(edges.get(pid, []))

        for f in todo:
            pid = owner(f)
            if pid is None:
                needed.append((f, "not attributable to a crate; runs by default"))
            elif pid in closure:
                needed.append((f, f"in `{pkgs[pid][0]}`, which the proofs build"))
            else:
                inert.append((f, f"in `{pkgs[pid][0]}`, outside every harness crate's closure"))
    except Exception as e:  # noqa: BLE001 -- any failure here must fail toward running
        print(f"  could not compute the dependency closure ({e}); running by default")
        needed.extend((f, "closure unavailable") for f in todo)

if not changed:
    print("  empty diff; running by default")
    needed.append(("(none)", "empty diff"))

for f, why in inert:
    print(f"  inert   {f}  ({why})")
for f, why in needed:
    print(f"  needed  {f}  ({why})")
print("verify-scope: " + ("needed" if needed else "not-needed"))
PY
fi

# --shard k/n: prove a balanced slice of the crates, for CI to run n of these concurrently.
#
# Parsed here rather than passed through to `cargo kani`, which has no such flag. Deliberately after
# --affected-since above: a shard of a change that cannot reach a proof is still nothing to prove,
# and the two must compose or CI would ask every shard to decide the scope question separately and
# could get n different answers on a racing tree.
shard=""
if [ "$1" = "--shard" ]; then
	shard="$2"
	if [ -z "$shard" ]; then
		echo "usage: script/verify --shard <k>/<n>   (for example --shard 1/2)" >&2
		exit 2
	fi
	shift 2
fi

# --only <crate>: prove exactly one row of the table below.
#
# **It exists because one row's coverage depends on the machine running it** (milestone 304). Every
# other crate here is portable logic and proves the same thing wherever it runs; `kernel` does not.
# `kernel/src/arch/mod.rs` selects its subtree with `#[cfg(target_arch = ...)]`, and Kani compiles
# for the HOST, so `cargo kani -p kernel` on an aarch64 box proves `arch/aarch64/` and compiles no
# line of `arch/riscv64/` or `arch/x86_64/`. Two thirds of the architecture layer was out of the
# prover's reach for a `cfg` rather than for a construct, and nothing in the tree said so until
# milestone 255 found it.
#
# So the mechanism is a second host, and this is the flag that lets a job on one ask for the row
# that differs instead of re-proving the eighteen that do not. See
# `.github/workflows/verify.yml`'s `prove-kernel-aarch64` job (the `prove-kernel-x86_64` job until
# milestone 587 (most CI jobs do not need an arm64 host) moved the shards to x86_64 and the second
# host became aarch64) and
# design/roadmap/304-prover-one-architecture.md.
#
# It refuses a crate that is not in the table, rather than passing the name to `cargo kani` and
# proving nothing while reporting success: a typo here would be the same invisible green the
# missing-row failures above cost this file twice.
#
# Name provisional (milestone 304): calef names what a reader meets, and a flag is an interface.
only=""
if [ "$1" = "--only" ]; then
	only="$2"
	if [ -z "$only" ]; then
		echo "usage: script/verify --only <crate>   (for example --only kernel)" >&2
		exit 2
	fi
	if [ -n "$shard" ]; then
		echo "script/verify: --only and --shard both select crates; pass one" >&2
		exit 2
	fi
	shift 2
fi

# **`VERIFY_CARGO_KANI` names a different `cargo kani`** (milestone 589; name provisional), and it
# exists for exactly one caller: script/verify-riscv64, whose patched Kani cannot be reached as
# `cargo kani` on a machine that also has the stock one, because cargo searches `$CARGO_HOME/bin`
# before PATH for its subcommands. When it is set, the stock install below is refused rather than
# attempted: stock Kani ignores the riscv64 target, so installing it would prove the host's `arch/`
# and report it as the one that was asked for.
if [ -n "${VERIFY_CARGO_KANI:-}" ]; then
	if ! "$VERIFY_CARGO_KANI" --version >/dev/null 2>&1; then
		echo "script/verify: VERIFY_CARGO_KANI=$VERIFY_CARGO_KANI does not run; refusing to fall back to stock Kani" >&2
		exit 1
	fi
	kani() { "$VERIFY_CARGO_KANI" "$@"; }
else
	kani() { cargo kani "$@"; }
fi

if [ -z "${VERIFY_CARGO_KANI:-}" ] && ! cargo kani --version >/dev/null 2>&1; then
	echo "==> installing Kani (first run only)"
	cargo install --locked kani-verifier
	cargo kani setup
fi

# Verify harnesses in parallel. The suite was serial twice over (one harness at a time, one crate
# at a time) and nothing required it: harnesses are independent, so this is the classic
# embarrassingly-parallel shape. What parallelism cannot buy is the floor: each harness is one
# formula handed to one single-threaded SAT solver, so wall time never drops below the longest
# harness (glob's, minutes on its own).
#
# Four jobs, not "all cores", because the bound is memory: notes/verification.md records a harness
# that reached 3.5 GB, and concurrent harnesses multiply the peak. Four fits the dev Mac and
# cordoba's 23 GB; **CI's 16 GB runner fits two**, measured the hard way: four runs were
# memory-killed mid-glob before verify.yml pinned VERIFY_JOBS=2 (the kill reports as a bare
# "operation was canceled", which cost an evening to attribute). Override with VERIFY_JOBS=N;
# VERIFY_JOBS=1 serializes the execution again (the output stays terse either way).
#
# Kani requires --output-format=terse with --jobs, which trades the counterexample trace for the
# parallelism; a failure still names its harness in the summary. To see the full trace, rerun that
# one harness serially: `cargo kani -p <crate> --harness <name>`.
set -- -j "${VERIFY_JOBS:-4}" --output-format=terse

# The crates carrying proof harnesses, with what each one COSTS. Grow this list as verification
# spreads inward from the capability core toward IPC and the MMU invariants.
#
# The seconds are a measurement, not an estimate: taken 2026-08-14 from a real CI run of this job
# (VERIFY_JOBS=2 on ubuntu-24.04-arm), and they exist so `--shard` can balance by time rather than by
# crate count. Milestone 119 asked for that explicitly, because the distribution is extreme: **two
# crates are 83% of the job**, and a four-way split by crate count would put three shards on coffee
# breaks while one did everything.
#
#     glob           15.0 min   49.7%
#     calendar       10.0 min   33.0%
#     dma_validator   2.9 min    9.6%
#     gpt             1.1 min    3.5%
#     the other 15    1.4 min    4.2%
#
# The rows keep the names the run measured: `gpt` is `globally_unique_identifier_partition_table`
# since 2026-09-18 (DECISIONS §154), and the shard table below uses the current name.
#
# **They drift, and a stale number costs balance rather than correctness**: a shard that is slower
# than its sibling still proves exactly the same harnesses, so this table can never make the proofs
# wrong. Re-measure by reading the `==> kani:` timestamps out of a CI log, which is what produced
# these, rather than by running the suite locally for half an hour.
#
# **A MISSING ROW is the one way this table can make the proofs wrong**, and it happened. `multicast_dns_protocol`
# landed with milestone 55 carrying three harnesses and was not added here, so nothing proved them and
# nothing said so: the suite went green faster, which is exactly the invisible failure the sharding
# comment below warns about, arriving through the crate list instead of through the packer. Found on
# 2026-08-16 by milestone 125, whose `harness-crates` count is derived from the tree and so could not
# agree with a list that was one crate short. Its 21 seconds are measured on the dev Mac rather than
# from a CI log, which is the wrong machine for this column and is why the row is a slight
# underestimate. The crate and its row were retired on 2026-09-15 (milestone 298, notes/mdns.md);
# this paragraph is kept as the account of the failure.
#
# **It happened a second time, and the fix is a gate rather than another paragraph** (milestone 193,
# 2026-08-30). `jh7110_entropy` had carried three harnesses since the board work and appeared nowhere in
# this file; the three pass, and now they run. Nothing in the tree could have found either it or
# `multicast_dns_protocol`, because the packer's partition assertion below checks that the shards cover this
# TABLE and never that this table covers the TREE. `script/lint`'s "every crate with proof harnesses
# is in the verify table" check is that missing comparison, and it costs a second instead of 42
# minutes. Its 6 seconds are a dev-Mac number and the wrong machine for this column; replace it from
# the first CI log that carries it.
#
# `kernel`'s 5 seconds are the same kind of number and carry one extra caveat: what the solver spends
# is milliseconds, and the row is almost entirely the crate's own compile. It will grow with the
# harnesses rather than with the kernel.
#
# **And `kernel` is the one row whose MEANING depends on the machine** (milestone 304). It is proved
# twice, on two hosts, because `crate::arch` dispatches on the host's `target_arch` under Kani: an
# aarch64 host proves `arch/aarch64/` plus the portable harnesses, an x86_64 host proves
# `arch/x86_64/` plus the same portable ones, and the two sets are not the same harnesses. Nothing
# proves `arch/riscv64/` and nothing can; see `--only` above and the milestone's block.
#
# **No apostrophes in this table, anywhere, ever** (found 2026-08-24). The `paging` row used to read
# "the IOMMU domain's page set"; that one apostrophe, alone, made the dev Mac's `/bin/sh` (bash
# 3.2.57) fail to parse this whole file with "unexpected EOF looking for matching `)'", despite the
# heredoc's delimiter being quoted (`<<'TABLE'`), which POSIX says makes the body fully literal. Real
# bash 3.2 bug, confirmed by bisection: removing the one apostrophe fixed it with nothing else
# changed. `script/lint`'s `sh -n` check (added the same day) catches a regression here; this comment
# is why a future editor should not just delete that check to add one back.
CRATES="$(cat <<'TABLE'
capability	8	the capability model
paging	9	the address arithmetic, and the page set for an IOMMU domain
memory_regions	1	the untyped-region accounting, no double-free
elf	40	the loader's front half, and the note walk, panic-free on hostile input
page_frames	4	the physical frame allocator
device_tree_blob	3	the device-tree parser's leaf readers
inter_process_communication	4	the rendezvous state machine
generational_table	4	the generational thread table
intrusive_fifo	9	the scheduler's queue structure
address_space_identifier	4	the TLB tag allocator
nifefs	2	the initrd parser the kernel runs on boot input
manifest_note	100	a manifest note has one encoding, and decoding hostile bytes never panics
package_archive	4	a package file is refused or read entirely inside itself, on bytes the solver chose
pci	6	config-space decode on hostile-device input
non_volatile_memory_express	2	the queue rings never index out, and the doorbell/PRP arithmetic is total
direct_memory_access_validator	175	the DMA-confinement validator, no descriptor escapes the grant
network_time_protocol	17	the 1900-epoch era pivot, and no hostile packet moves the clock
globally_unique_identifier_partition_table	64	the partition table's CRC-32, its round trips, and partitions that overlap
calendar	600	the civil-date arithmetic, and the parser on hostile text
glob	902	matching is total, and a hostile pattern cannot be made to blow up
filesystem_protocol	1	a directory capability's child never exceeds its parent, at any depth
credential_protocol	4	no request word reads outside the page; nothing but MATCH authenticates
component_plan	10	no wiring grants a right its declaration did not ask for
timetable	5	the scheduler's fire arithmetic: strictly forward, minimal, and a stall costs one fire
jh7110_entropy	6	the board TRNG's status decode, and that a lockup bit is never overridden
kernel	5	the run arithmetic in the kernel's own syscall dispatch, and the SMMU entries that say which frames a device may reach
components	3	the EL0 components: a bounded append that a configuration page this system did not write feeds
machine_discovery	180	the firmware tables and boot handoffs: ACPI, PVH, the screen token, the RISC-V ISA string
TABLE
)"

# --shard k/n: prove this shard's crates only.
#
# **The floor is one harness, and it is measured.** Packing these by time, two shards reach 15.1
# minutes and three or four reach 15.0, because `glob` is atomic at 15.0 and cannot be split at crate
# granularity. Below that needs per-harness sharding, whose own floor is
# `glob::the_dot_rule_only_touches_names_that_start_with_a_dot` at **10.8 minutes on its own**. The
# ladder is 30.3 serial, 15.1 at two shards, 10.8 at unbounded per-harness sharding, and nothing
# below that without making that one harness cheaper, which is an unwind bound in `glob` rather than
# a CI question.
#
# Two shards is where this stops: 2.0x of the available 2.8x for a fraction of the machinery, and a
# third or fourth runner buys **nothing at all**. See notes/verification.md.
if [ -n "$shard" ]; then
    crates="$(printf '%s\n' "$CRATES" | SHARD="$shard" python3 -c '
import os, sys
spec = os.environ["SHARD"]
try:
    k, n = (int(x) for x in spec.split("/", 1))
except ValueError:
    sys.exit("script/verify: --shard wants k/n (for example 1/2), got %r" % spec)
rows = []
for line in sys.stdin:
    if line.strip():
        name, secs, _desc = line.rstrip("\n").split("\t", 2)
        rows.append((int(secs), name))
if not 1 <= k <= n:
    sys.exit("script/verify: shard %d/%d is out of range" % (k, n))
if n > len(rows):
    sys.exit("script/verify: %d shards for %d crates leaves empty ones" % (n, len(rows)))
# Greedy longest-processing-time, the standard makespan heuristic. Sorting first is the whole trick:
# a round-robin over the table order puts glob and calendar in the same bin and doubles the shard.
rows.sort(reverse=True)
bins = [[] for _ in range(n)]
load = [0] * n
for secs, name in rows:
    i = load.index(min(load))
    bins[i].append(name)
    load[i] += secs

# **The shards must partition the table exactly**, and this asserts it on every invocation rather
# than in a gate somebody has to run. A crate dropped from every shard is not proved at all, and
# that failure is INVISIBLE: the suite goes green faster and nothing says a harness stopped
# running. A crate in two shards only wastes a runner. So the dangerous direction is checked here,
# where it cannot drift away from the code that does the packing.
placed = [name for b in bins for name in b]
if sorted(placed) != sorted(name for _, name in rows) or len(placed) != len(set(placed)):
    sys.exit("script/verify: sharding did not partition the crate table; refusing to prove a "
             "subset and report it as the suite")

sys.stderr.write("shard %d/%d: %d crates, ~%.1f min of a %.1f-minute serial total\n"
                 % (k, n, len(bins[k - 1]), load[k - 1] / 60, sum(load) / 60))
print(" ".join(bins[k - 1]))
')"
elif [ -n "$only" ]; then
    if ! printf '%s\n' "$CRATES" | cut -f1 | grep -qx "$only"; then
        echo "script/verify: --only $only is not a row in the crate table; refusing to prove" \
             "nothing and report it as a suite" >&2
        exit 2
    fi
    crates="$only"
else
    crates="$(printf '%s\n' "$CRATES" | cut -f1 | tr '\n' ' ')"
fi

# **`kernel` is the one row that needs flags of its own** (milestone 193), and they are here rather
# than in a fourth table column because there is exactly one of them and a column would invite more.
#
# Kani refuses a crate containing `global_asm!` outright unless told to ignore it, and the kernel has
# eleven such blocks: the boot entry, the vector table and the context switch on all three
# architectures. None of them is reachable from any harness, and none is reachable from any harness
# that could ever be written, because the same restriction applies to `asm!` one level down. So this
# flag does not weaken a proof that would otherwise hold; it converts a refusal to compile into a
# stub whose boundary is written down. **Read `notes/kernel-proofs.md` before adding a harness to
# `kernel/src`**: it enumerates every stub, and the whole hazard of proving a crate like this one is
# that a stub reads as coverage.
#
# `-Z stubbing` (2026-09-25) lets a harness replace a one-instruction wrapper under `arch/` with a
# model (`#[kani::stub]`), which is how logic around an `asm!` site becomes reachable at all. Each
# such model is an assumption about the hardware; notes/kernel-proofs/stubbing-an-instruction.md
# is the pattern and the caveat, and every harness using one lists what it assumes.
for c in $crates; do
    desc="$(printf '%s\n' "$CRATES" | awk -F'\t' -v c="$c" '$1 == c { print $3 }')"
    case "$c" in
        kernel) extra="-Z unstable-options --ignore-global-asm -Z stubbing" ;;
        # `components` is 49 `[[bin]]` targets and one package, so a bare `cargo kani -p components`
        # compiles all 49. Kani refuses every `#![no_std]` crate root that does not mention it
        # ("Failed to detect Kani functions"), so that run fails on the first binary carrying no
        # harness, and the alternative -- `extern crate kani` in 49 files -- would be an edit in
        # every program in the tree to prove logic in one of them.
        #
        # So the binaries are SELECTED, and the selection is **derived from the tree** rather than
        # written here. A list would be one name short the first time somebody adds a harness to a
        # 69th program, and that failure is the invisible one this file has now recorded twice
        # (`multicast_dns_protocol`, `jh7110_entropy`): the suite goes green faster and nothing says a harness
        # stopped running. `script/lint` catches a whole crate missing from the table above; only
        # this can catch a binary missing from within one.
        #
        # It selects on the FILE name, and `components/src` holds two files that are not binaries
        # (`net_transport.rs` and `socket_test_client.rs`, `net_stack`'s single-consumer
        # `#[path]` modules, which rule 7 permits). A harness in one of those would produce a
        # `--bin` cargo does not know, and cargo says so and stops; the failure is loud, which
        # is the direction that is safe to leave alone.
        #
        # **`fixtures` is deliberately not a row above**, because it carries no harness today and a
        # row with none fails the way this comment describes. See notes/user-proofs.md's BUGS for
        # what that costs: a harness added to a fixture runs nowhere until somebody adds the row.
        components)
                extra="$(git grep -lF '#[kani::proof]' -- 'components/src/*.rs' \
                    | sed 's|components/src/||; s|\.rs$||' \
                    | sed 's|^|--bin |' | tr '\n' ' ')" ;;
        *)      extra="" ;;
    esac
    echo "==> kani: $c ($desc)"
    # Unquoted on purpose: `extra` is either empty or two flags, and quoting it would hand cargo one
    # argument that is the empty string.
    # shellcheck disable=SC2086
    kani -p "$c" $extra "$@"
done
