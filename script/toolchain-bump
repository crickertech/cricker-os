#!/bin/sh
# script/toolchain-bump [YYYY-MM-DD]: raise the pinned nightly, with evidence.
#
# rust-toolchain.toml pins a dated nightly so builds are reproducible and a toolchain change is a
# deliberate commit rather than a surprise (see the comment in that file for the incident that
# prompted it). The cost of pinning is that staying current becomes an action somebody has to take;
# this is that action, so it is one command instead of a remembered sequence.
#
# The daily `toolchain drift` workflow is the other half: it builds against the newest nightly and
# tells you when upstream has moved away from us. When it goes red, run this.
#
# With no argument it targets today. On success the working tree holds the new pin and a rebuilt std
# farm, ready to commit; on failure it says what broke and leaves the old pin in place, because a
# half-applied toolchain bump is worse than none.
#
# Name: recorded (DECISIONS §134, which puts a `script/` entry point that *does* something in the
# verb half). Introduced 2026-07-30. AGENTS.md's name-things-with-nouns rule is written for
# crates, programs and modules and does not reach this directory, which §134 then made explicit by
# splitting the family: the verbs are the ones that act (`verify`, `test`, `fuzz`, `bench`) and
# this acts. What is left unsigned is the word order rather than the words. `<object>-<verb>` is
# established here only by this script and `vendor-verify`, which is two scripts establishing each
# other, and nothing weighs it against `bump-toolchain`. no architect has ratified it.

set -e
cd "$(dirname "$0")/.."

# This project's own QEMU, if `script/ci-qemu` has built one (helpers/qemu-path.sh says why
# PATH is the mechanism). A no-op on macOS and on any machine without that prefix.
. helpers/qemu-path.sh

date_arg="${1:-$(date -u +%Y-%m-%d)}"
new="nightly-$date_arg"
old="$(awk -F'"' '/^channel/ {print $2}' rust-toolchain.toml)"

if [ "$old" = "$new" ]; then
    echo "toolchain-bump: already pinned to $new; nothing to do."
    exit 0
fi

echo "==> Bumping the pin: $old -> $new"

# Install first. If the date does not exist upstream (a nightly can be missing), fail here, before
# the tree has been touched.
rustup toolchain install "$new" --profile minimal \
    --component rust-src,llvm-tools,rustfmt,clippy
# **Every target the pin declares**, read from the file rather than spelled here. This is the copy
# that actually bit: it installs against the NEW toolchain, which rustup has not applied the pin's
# `targets` array to yet, so the omission of `x86_64-unknown-none` was not covered the way it was
# everywhere else, and the first x86_64 build after a bump was the thing that discovered it. Read
# before the pin is raised, so it is the outgoing array; that is correct, because a bump does not
# change which architectures the tree supports. See notes/architecture-list-sweep.md, option A.
all_targets="$(awk -F'"' '/^targets *=/ {for (i = 2; i < NF; i += 2) printf "%s ", $i}' rust-toolchain.toml)"
# shellcheck disable=SC2086  # word splitting is the point: one flag per target
rustup target add --toolchain "$new" $all_targets

# Restore the old pin if anything below fails, so a failed bump leaves a buildable tree.
restore() {
    echo "toolchain-bump: FAILED; restoring the pin to $old" >&2
    sed -i.bak "s|^channel = \"$new\"|channel = \"$old\"|" rust-toolchain.toml
    rm -f rust-toolchain.toml.bak
    echo "toolchain-bump: the tree still builds on $old. Nothing was committed." >&2
}
trap restore EXIT INT TERM

sed -i.bak "s|^channel = \"$old\"|channel = \"$new\"|" rust-toolchain.toml
rm -f rust-toolchain.toml.bak

# The std overlay is where a bump actually bites: it patches std's own source, so it tracks upstream
# internals rather than a stable API. A stale farm would hide exactly the breakage we are checking
# for, which is how the 2026-07-30 incident stayed invisible on a developer machine for two days.
echo "==> Rebuilding the std overlay from scratch (the fragile part)"
rm -rf target/nife-farm
if ! cargo xtask std-exerciser; then
    echo >&2
    echo "toolchain-bump: the std overlay does not build on $new." >&2
    echo "  This is the expected failure mode. Look for a symbol upstream added to sys::fs that" >&2
    echo "  patches/std-nife/overlay/std/src/sys/fs/nife.rs does not re-export from" >&2
    echo "  unsupported_fs, add it to that list, and re-run." >&2
    exit 1
fi

echo "==> Full gate on the new toolchain"
script/fmt --check
# **`NIFE_BUMP_IN_PROGRESS` is an exception and it is a foot gun, so it says so here.**
#
# `script/lint` fails when `bench/baseline-*.txt` names a nightly other than the pinned one, which
# is the mechanism that stops a bump silently revaluing the icount floors. This script has just
# raised the pin and has not re-recorded anything, so that check is guaranteed to fire, and firing
# here would trip the restore trap above and un-bump a tree that is otherwise fine. So the bump, and
# only the bump, turns that one check off while it runs.
#
# What keeps it honest is that the enforcement was never here. It is `script/lint` in CI on the
# pull request the bump becomes, where this variable is not set and cannot be, and where the
# baselines and the pin must agree before anything merges. Setting it anywhere else buys a green
# lint that means nothing.
echo "    (NIFE_BUMP_IN_PROGRESS=1: the baseline-nightly check is the one thing a bump is expected"
echo "     to fail, and CI on the resulting pull request is what actually enforces it.)"
NIFE_BUMP_IN_PROGRESS=1 script/lint
script/test

trap - EXIT INT TERM
echo
echo "==> Bumped to $new, and every gate passed."
echo "    Commit rust-toolchain.toml (and the overlay, if it needed new re-exports)."
echo

# **The floors are now measured against a compiler that is no longer the pinned one.**
#
# icount counts guest instructions, so `$new` revalues every number in `bench/baseline-*.txt`
# without a line of this repository changing. Leaving them alone is what happened on 2026-09-15:
# the pin moved, the floors did not, most of the tripwire's headroom went, and the tree was bumped
# again before anyone noticed. It was luck rather than design that the drift later evaporated.
#
# **This script does not re-record them for you, and that refusal is the design.** A bump that
# re-saved the floors as part of raising the pin would make them track the compiler by construction:
# a nightly that genuinely made this kernel slower would move the floor by exactly as much as it
# moved the kernel and report nothing, and catching precisely that is most of what the tripwire is
# for. So the re-save stays a deliberate act, in this bump's own commit, by somebody who has read
# the delta. `script/lint` refuses to pass until it happens.
# The restamp is milestone 598 (a nightly bump restamps the floors it proves it did not move).
echo "==> One thing is left: the icount floors. The scheduled workflow's restamp job carries them"
echo "    across when it proves the compiler moved no row (calef, 2026-09-26). By hand, try that"
echo "    first:"
echo
echo "        script/bench --restamp && script/bench --riscv --restamp && script/bench --x86 --restamp"
echo
echo "    and re-record any floor whose leg refuses, as below."
echo
echo "    The icount floors in bench/baseline-*.txt still name the OLD nightly. A new compiler"
echo "    emits different instruction sequences, so those numbers have been revalued by a change"
echo "    nothing in this tree is responsible for. Re-record them IN THIS COMMIT, having read what"
echo "    moved:"
echo
echo "        script/bench --check         # read the deltas first; this is the part that matters"
echo "        script/bench --riscv --check"
echo "        script/bench --x86 --check"
echo "        script/bench --save --why \"nightly bump: <what moved>\"   # --why is required"
echo "        script/bench --riscv --save --why \"...\" && script/bench --x86 --save --why \"...\""
echo
echo "    A floor that moved a long way is not a formality to click past: a nightly can make this"
echo "    kernel genuinely slower, and re-saving without reading the delta is the one outcome this"
echo "    mechanism refuses to automate. The --why goes in the file beside the numbers, and says"
echo "    the same thing the commit message says (milestone 302 (a baseline records what it was saved against))."
