+++ b/components/src/fs_subtree_caretaker.rs
@@ -303,7 +303,7 @@ pub extern "C" fn _start(name_lo: u64, name_hi: u64, spec: u64) -> ! {
     }
 
     send(REPORT, filesystem_protocol::fixture::READY, 0, 0);
-    serve(r0);
+    serve(fs::ROOT);
 }
 
 user_mode_runtime::panic_handler!();
