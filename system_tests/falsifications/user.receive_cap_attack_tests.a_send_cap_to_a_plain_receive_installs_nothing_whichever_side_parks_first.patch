-                    // sender keeps its own copy: `SEND_CAP` narrows a copy, never the source.
-                    r.mailbox = [data, 0, 0, badge, 0];
-                }
+                let slot = deliver_capability(caps, capability);
+                r.mailbox = [data, slot, 0, badge, 0];
+                r.cap_delivered = true;
