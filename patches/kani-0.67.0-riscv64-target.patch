diff --git a/tools/build-kani/src/sysroot.rs b/tools/build-kani/src/sysroot.rs
index bb8708a..7faa92b 100644
--- a/tools/build-kani/src/sysroot.rs
+++ b/tools/build-kani/src/sysroot.rs
@@ -67,7 +67,7 @@ fn kani_sysroot_bin() -> PathBuf {
 
 /// Returns the build target
