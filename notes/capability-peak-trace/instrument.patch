@@ -0,0 +1,178 @@
+//! MEASUREMENT PATCH (lane/capability-peak-trace). Not for landing: records every mutation of the
+//! progenitor's capability table (and any table that climbs past 24) into a ring, and drains the
+//! ring through semihosting to `target/cap-trace.txt` (append) from the idle loop.
+use core::fmt::Write;
+use core::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+
+pub static TRACE_TABLE: AtomicUsize = AtomicUsize::new(0);
+pub static TRACE_TID: AtomicU64 = AtomicU64::new(u64::MAX);
+static PC: [AtomicU64; crate::cpu::MAX_CPUS] = [const { AtomicU64::new(0) }; crate::cpu::MAX_CPUS];
+const BT: usize = 24;
+static mut STACKS: [[u64; BT]; crate::cpu::MAX_CPUS] = [[0; BT]; crate::cpu::MAX_CPUS];
+
+#[derive(Clone, Copy)]
+struct Rec {
+    table: usize,
+    slot: u8,
+    op: u8,
+    used: u8,
+    pc: u64,
+    tid: crate::thread::ThreadId,
+    cap: crate::cap::Cap,
+    bt: [u64; BT],
+}
+
+const N: usize = 16384;
+static mut RING: [Option<Rec>; N] = [const { None }; N];
+static HEAD: AtomicUsize = AtomicUsize::new(0);
+static TAIL: AtomicUsize = AtomicUsize::new(0);
+static DRAINING: AtomicBool = AtomicBool::new(false);
+static FD: AtomicU64 = AtomicU64::new(u64::MAX);
+
+pub fn note_pc(pc: u64, lr: u64, fp: u64, sp: u64) {
+    let c = crate::cpu::id();
+    PC[c].store(pc, Ordering::Relaxed);
+    let mut bt = [0u64; BT];
+    bt[0] = lr;
+    let top = crate::user::USER_STACK_VA + 4096;
+    if crate::sched::current() != TRACE_TID.load(Ordering::Relaxed) || sp >= top || sp < top - 13 * 4096 {
+        unsafe { (*core::ptr::addr_of_mut!(STACKS))[c] = bt };
+        return;
+    }
+    let mut k = 1;
+    let mut fp = fp;
+    while k < BT && fp >= sp && fp + 16 <= top && fp % 8 == 0 {
+        let next = unsafe { core::ptr::read_volatile(fp as *const u64) };
+        bt[k] = unsafe { core::ptr::read_volatile((fp + 8) as *const u64) };
+        k += 1;
+        if next <= fp {
+            break;
+        }
+        fp = next;
+    }
+    unsafe { (*core::ptr::addr_of_mut!(STACKS))[c] = bt };
+}
+
+fn hook(table: usize, slot: usize, op: u8, used: usize, cap: *const u8) {
+    let ours = table == TRACE_TABLE.load(Ordering::Relaxed);
+    if !ours && used < 25 {
+        return;
+    }
+    let i = HEAD.fetch_add(1, Ordering::Relaxed);
+    if i >= N {
+        return;
+    }
+    let cap = unsafe { *(cap as *const crate::cap::Cap) };
+    let rec = Rec {
+        table,
+        slot: slot as u8,
+        op,
+        used: used as u8,
+        pc: PC[crate::cpu::id()].load(Ordering::Relaxed),
+        tid: crate::sched::current(),
+        cap,
+        bt: unsafe { (*core::ptr::addr_of!(STACKS))[crate::cpu::id()] },
+    };
+    unsafe { (*core::ptr::addr_of_mut!(RING))[i] = Some(rec) };
+}
+
+pub fn install() {
+    capability::TRACE_HOOK.store(hook as usize, Ordering::Relaxed);
+}
+
+struct Buf {
+    b: [u8; 1024],
+    n: usize,
+}
+impl Write for Buf {
+    fn write_str(&mut self, s: &str) -> core::fmt::Result {
+        let k = core::cmp::min(s.len(), self.b.len() - self.n);
+        self.b[self.n..self.n + k].copy_from_slice(&s.as_bytes()[..k]);
+        self.n += k;
+        Ok(())
+    }
+}
+
+#[cfg(target_arch = "aarch64")]
+fn semi(op: u64, arg: *const u64) -> u64 {
+    let r: u64;
+    unsafe {
+        core::arch::asm!("hlt #0xf000", inout("x0") op => r, in("x1") arg);
+    }
+    r
+}
+#[cfg(target_arch = "riscv64")]
+fn semi(op: u64, arg: *const u64) -> u64 {
+    let r: u64;
+    unsafe {
+        core::arch::asm!(
+            ".option push", ".option norvc", ".balign 16",
+            "slli x0, x0, 0x1f", "ebreak", "srai x0, x0, 7",
+            ".option pop",
+            inout("a0") op => r, in("a1") arg);
+    }
+    r
+}
+#[cfg(target_arch = "x86_64")]
+fn semi(_op: u64, _arg: *const u64) -> u64 {
+    u64::MAX
+}
+
+fn write_out(bytes: &[u8]) {
+    let mut fd = FD.load(Ordering::Relaxed);
+    if fd == u64::MAX {
+        let secs = semi(0x11, core::ptr::null());
+        let mut path = *b"target/cap-trace/boot-0000000000.txt\0";
+        let mut v = secs;
+        for k in (0..10).rev() {
+            path[22 + k] = b'0' + (v % 10) as u8;
+            v /= 10;
+        }
+        let blk = [path.as_ptr() as u64, 4 /* "w" */, (path.len() - 1) as u64];
+        fd = semi(0x01, blk.as_ptr());
+        FD.store(fd, Ordering::Relaxed);
+        let hdr = b"=== BOOT ===\n";
+        let blk = [fd, hdr.as_ptr() as u64, hdr.len() as u64];
+        semi(0x05, blk.as_ptr());
+    }
+    let blk = [fd, bytes.as_ptr() as u64, bytes.len() as u64];
+    semi(0x05, blk.as_ptr());
+}
+
+pub fn drain() {
+    if DRAINING.swap(true, Ordering::Acquire) {
+        return;
+    }
+    let head = core::cmp::min(HEAD.load(Ordering::Relaxed), N);
+    let mut t = TAIL.load(Ordering::Relaxed);
+    let ours = TRACE_TABLE.load(Ordering::Relaxed);
+    while t < head {
+        let rec = unsafe { (*core::ptr::addr_of!(RING))[t] };
+        let Some(r) = rec else { break };
+        let mut b = Buf { b: [0; 1024], n: 0 };
+        let _ = writeln!(
+            b,
+            "{t} {} {} slot={} used={} pc={:#x} tid={:?} {:?} rights={:#x} bt={:x?}",
+            if r.table == ours { "P" } else { "X" },
+            match r.op { 0 => "-", 1 => "+", _ => "=" },
+            r.slot,
+            r.used,
+            r.pc,
+            r.tid,
+            r.cap.object,
+            r.cap.rights.bits(),
+            r.bt,
+        );
+        if r.table != ours {
+            let _ = writeln!(b, "   (table {:#x})", r.table);
+        }
+        write_out(&b.b[..b.n]);
+        t += 1;
+    }
+    TAIL.store(t, Ordering::Relaxed);
+    if HEAD.load(Ordering::Relaxed) > N && t == N {
+        write_out(b"RING FULL\n");
+        TAIL.store(N + 1, Ordering::Relaxed);
+    }
+    DRAINING.store(false, Ordering::Release);
+}
