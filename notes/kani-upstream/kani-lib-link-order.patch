@@ -0,0 +1,10 @@
+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! Any harness will do: the test inspects the goto binaries Kani writes for it, not its verdict.
+
+#[kani::proof]
+fn check_linked_machine_model() {
+    let x: u8 = kani::any();
+    assert!(u16::from(x) <= 255);
+}
diff --git a/tests/script-based-pre/linked_machine_model/linked_machine_model.sh b/tests/script-based-pre/linked_machine_model/linked_machine_model.sh
new file mode 100755
index 000000000..e760a11df
--- /dev/null
+++ b/tests/script-based-pre/linked_machine_model/linked_machine_model.sh
@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+
+# Check that linking does not change the machine model Kani wrote. kani-compiler writes the
+# target's model into each harness's symbol table as `__CPROVER_architecture_*` symbols, and CBMC
+# reads those symbols from the linked binary to decide how to interpret C (`kani_lib.c`, its own C
+# library, any `--c-lib`). If `goto-cc` compiles C source in the link step, its host configuration
+# replaces those symbols. Every field Kani wrote must therefore reach the linked `.out` unchanged.
+# No values are hard-coded, so the test runs on every host; it can only fail on a host whose
+# `goto-cc` configuration differs from Kani's model for that target.
+set -eu
+
+tmp_dir=$(mktemp -d)
+trap 'rm -rf "${tmp_dir}"' EXIT
+cp linked_machine_model.rs "${tmp_dir}"
+cd "${tmp_dir}"
+
+kani linked_machine_model.rs --keep-temps
+
+# Print one `name value` line per `__CPROVER_architecture_*` symbol of a goto binary, with the
+# `(__CPROVER_integer)` cast the link adds removed so that values compare as written.
+machine_model() {
+    goto-instrument --show-symbol-table "$1" | awk '
+        /^Symbol\.+: __CPROVER_architecture_/ { name = $2; next }
+        /^Symbol/ { name = "" }
+        /^Value\.+:/ && name != "" {
+            value = $0
+            sub(/^Value\.+: /, "", value)
+            sub(/^\(__CPROVER_integer\)/, "", value)
+            print name, value
+            name = ""
+        }' | sort
+}
+
+harnesses=0
+for symtab in *.symtab.out; do
+    linked="${symtab%.symtab.out}.out"
+    if [ ! -e "${linked}" ]; then
+        echo "error: no linked binary \`${linked}\` for \`${symtab}\`"
+        exit 1
+    fi
+    machine_model "${symtab}" > written.txt
+    machine_model "${linked}" > linked.txt
+    if [ ! -s written.txt ]; then
+        echo "error: \`${symtab}\` has no __CPROVER_architecture_* symbols"
+        exit 1
+    fi
+    # Every line Kani wrote must appear, unchanged, in the linked binary. The link may add fields
+    # Kani does not write (`os`, for one), so only `written.txt` lines are required.
+    missing=$(comm -23 written.txt linked.txt)
+    if [ -n "${missing}" ]; then
+        echo "error: linking \`${symtab}\` changed the machine model Kani wrote"
+        echo "written by Kani, then missing or changed in \`${linked}\`:"
+        echo "${missing}"
+        echo "the linked binary has:"
+        grep -F -f <(echo "${missing}" | cut -d' ' -f1 | sed 's/$/ /') linked.txt || true
+        exit 1
+    fi
+    harnesses=$((harnesses + 1))
+done
+
+if [ "${harnesses}" -eq 0 ]; then
+    echo "error: no \`.symtab.out\` files; did --keep-temps stop keeping them?"
+    exit 1
+fi
+echo "the linked goto binary keeps the machine model Kani wrote"
