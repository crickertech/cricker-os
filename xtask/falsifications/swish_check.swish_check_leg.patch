+        let lent = [t.gpu[0], t.gpu[1], t.gpu[2], t.gpu[3], t.kbd[0], t.kbd[1], t.kbd[2]];
+        let (w, r, rw) = (abi::rights::WRITE, abi::rights::READ, abi::rights::READ | abi::rights::WRITE);
+        let rights = [w, r, rw, rw, w, r, rw];
+        for (i, cap) in lent.iter().enumerate() {
