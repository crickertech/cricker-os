#!/bin/sh
# pre-push: the formatting gate, the whole lint, and the ready-status check, run where they are cheap.
#
# CI's rustfmt is one of seven required checks, and a lane that pushes unformatted code learns
# that from a runner ten minutes later, then pushes again. Every lane on 2026-08-15 and -16 paid
# that tax at least once, three of them on the same night, which is a gate teaching the wrong
# lesson: "run CI to find out how to format". This runs the identical check in ~0.7 s before the
# push leaves the machine.
#
# Clippy joined on 2026-09-29 (calef: "run the clippy gate before they push, since we see regular
# failures of that gate"), for the same reason one level up: #1424 reached CI with stale lints and
# #1442's push left before its lint was read, and both are a red runner teaching "run CI to find
# out what clippy thinks". The hook ran `script/lint --clippy`, the identical clippy passes CI
# runs, until milestone 630 (a merge-queue ejection is caught before the queue) widened it to all of lint (below).
#
# Installed by `script/setup` via core.hooksPath, so it covers every worktree sharing this .git
# (which is how lanes work) rather than needing per-worktree installation.
#
# Bypass with `git push --no-verify` when you mean it: pushing a work-in-progress branch for
# safekeeping is a legitimate reason, and this hook is a courtesy to the queue rather than a
# rule about what may exist on a branch.

root="$(git rev-parse --show-toplevel)"
[ -x "$root/script/fmt" ] || exit 0   # a branch predating the script pushes unimpeded

if ! "$root/script/fmt" --check >/dev/null 2>&1; then
    echo "pre-push: rustfmt would change files, and CI's rustfmt check will fail." >&2
    echo "  Fix:    script/fmt        (then commit and push again)" >&2
    echo "  Bypass: git push --no-verify" >&2
    exit 1
fi

# **The whole of `script/lint`, not `--clippy` and three hand-picked gates** (milestone 630,
# 2026-10-03). The hook grew one gate per incident: clippy (#1424, #1442), then the two prose
# ratchets (#1456), then the baselines check (#1463), each added after a full queue cycle was lost
# to it, and each new lint check was outside the hook until it, too, cost a cycle. Measured on
# patagonia (M-series, warm target directory, three runs each, wall clock, with two other lanes'
# QEMU running beside it, so these are a busy machine's numbers):
#
#     script/lint --clippy    27.36  32.90  26.71 s   (median 27.4)
#     script/lint             56.48  55.20  56.65 s   (median 56.5)
#
# The rest of lint adds about 29 s, and the three gates it replaces here cost about 6 of those
# already, so the hook gets about 22 s slower and stops having a list that lags the incidents. No
# single check after clippy is over 3.5 s (spelling 3.4, prose ratchet 3.0, counted claims 2.6,
# citations 2.6), so no fast/slow split was worth its second list. The numbers are in
# notes/scripts.md. A cold target directory makes the first push of a worktree slow either way;
# that was already true of `--clippy`.
#
# A `script/lint` reached through an old branch runs whatever that branch's lint is, which is the
# point: the push is judged by the tree being pushed.
out="$(mktemp "${TMPDIR:-/tmp}/nife-pre-push.XXXXXX")"
if ! "$root/script/lint" >"$out" 2>&1; then
    echo "pre-push: script/lint failed, and CI's clippy job (which runs all of it) will fail the same way." >&2
    tail -n 15 "$out" | sed 's/^/  | /' >&2
    echo "  Fix:    script/lint   (read its output, fix, commit, push again)" >&2
    echo "  Bypass: git push --no-verify" >&2
    rm -f "$out"
    exit 1
fi
rm -f "$out"

# **A ready pull request may not carry an IN-PROGRESS block on its own branch** (milestone 630).
# The same question `.github/workflows/ready-status.yml` asks on `pull_request`, asked here for a
# push to a branch whose pull request is already ready, so the answer comes before the push rather
# than a runner later. The merge group's roadmap check fails on exactly this 20 to 38 minutes into
# a queue attempt, and the ejection cancels auto-merge (#1473, 2026-10-03).
#
# The branch is the one being pushed, from stdin (`<local ref> <sha> <remote ref> <sha>`), not
# HEAD's. It needs `gh` and the network; with neither, or with no pull request, or a draft, it
# skips silently, because a draft's block is honest to say IN-PROGRESS and CI asks again anyway.
# The block is read from the working tree, as lint's is.
if [ -x "$root/script/roadmap" ] && grep -q -- '"--ready-branch"' "$root/script/roadmap" 2>/dev/null &&
    command -v gh >/dev/null 2>&1; then
    while read -r _ _ remote_ref _; do
        case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
        branch="${remote_ref#refs/heads/}"
        draft="$(gh pr view "$branch" --json isDraft -q .isDraft 2>/dev/null || true)"
        [ "$draft" = "false" ] || continue
        if ! "$root/script/roadmap" --ready-branch "$branch"; then
            echo "pre-push: the pull request for $branch is ready, and its block above still reads IN-PROGRESS." >&2
            echo "  Bypass: git push --no-verify" >&2
            exit 1
        fi
    done
fi
