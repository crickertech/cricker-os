#!/bin/sh
# pre-push: the formatting gate and the clippy gate, run where they are cheap.
#
# CI's rustfmt is one of seven required checks, and a lane that pushes unformatted code learns
# that from a runner ten minutes later, then pushes again. Every lane on 2026-08-15 and -16 paid
# that tax at least once, three of them on the same night, which is a gate teaching the wrong
# lesson: "run CI to find out how to format". This runs the identical check in ~0.7 s before the
# push leaves the machine.
#
# Clippy joined on 2026-09-29 (calef: "run the clippy gate before they push, since we see regular
# failures of that gate"), for the same reason one level up: #1424 reached CI with stale lints and
# #1442's push left before its lint was read, and both are a red runner teaching "run CI to find
# out what clippy thinks". The hook runs `script/lint --clippy`, the identical clippy passes CI
# runs, from this file's single copy; a cold target directory makes the first push slow and a warm
# one makes it seconds, which is the price of the gate and cheaper than the queue's round trip.
#
# Installed by `script/setup` via core.hooksPath, so it covers every worktree sharing this .git
# (which is how lanes work) rather than needing per-worktree installation.
#
# Bypass with `git push --no-verify` when you mean it: pushing a work-in-progress branch for
# safekeeping is a legitimate reason, and this hook is a courtesy to the queue rather than a
# rule about what may exist on a branch.

root="$(git rev-parse --show-toplevel)"
[ -x "$root/script/fmt" ] || exit 0   # a branch predating the script pushes unimpeded

if ! "$root/script/fmt" --check >/dev/null 2>&1; then
    echo "pre-push: rustfmt would change files, and CI's rustfmt check will fail." >&2
    echo "  Fix:    script/fmt        (then commit and push again)" >&2
    echo "  Bypass: git push --no-verify" >&2
    exit 1
fi

# A `script/lint` that predates `--clippy` ignores the flag and runs in full, which is slower and
# still correct; CI judges either way, as it did before 2026-09-29.
if ! "$root/script/lint" --clippy >/dev/null 2>&1; then
    echo "pre-push: clippy failed, and CI's clippy check will fail the same way." >&2
    echo "  Fix:    script/lint --clippy   (read its output, fix, commit, push again)" >&2
    echo "  Bypass: git push --no-verify" >&2
    exit 1
fi

# The two prose gates joined on 2026-09-30, after #1456 reached CI failing only the citations
# ratchet and cost a full queue cycle: CI's "clippy" job runs the whole lint suite, so a push whose
# rust is clean but whose citations lack glosses reds a job named clippy and teaches nothing. Both
# checks are pure Python and run in seconds. `script/citations --ratchet` judges the committed
# tip, and the hook fires after a commit by construction, so the tip is what CI will judge.
if [ -x "$root/script/citations" ]; then
    if ! "$root/script/citations" --ratchet >/dev/null 2>&1; then
        echo "pre-push: the citations ratchet failed on the committed tip; CI's clippy job runs it too." >&2
        echo "  Fix:    script/citations --ratchet   (read the file and line it names, gloss the number there)" >&2
        echo "  Bypass: git push --no-verify" >&2
        exit 1
    fi
fi
if [ -f "$root/helpers/prose_ratchet.py" ]; then
    if ! python3 "$root/helpers/prose_ratchet.py" --check >/dev/null 2>&1; then
        echo "pre-push: the prose ratchet failed; CI's clippy job runs it too." >&2
        echo "  Fix:    python3 helpers/prose_ratchet.py --check   (split the sentence, cut bold or words)" >&2
        echo "  Bypass: git push --no-verify" >&2
        exit 1
    fi
fi

# The baseline-vs-pin check, 2026-09-30, one PR after the prose gates: #1463's toolchain bump
# pushed past an unread lint with the icount floors still naming the old nightly, and that
# failure is about tree state rather than code shape, so no gate above this block can see it.
# One Python file reading two text sources; `script/lint --baselines` is its one door.
if [ -x "$root/script/lint" ] && grep -q -- '"--baselines"' "$root/script/lint" 2>/dev/null; then
    if ! "$root/script/lint" --baselines >/dev/null 2>&1; then
        echo "pre-push: the icount baselines do not name the pinned nightly; lint and CI fail it too." >&2
        echo "  Fix:    script/lint --baselines   (it names the floor files and the restamp command)" >&2
        echo "  Bypass: git push --no-verify" >&2
        exit 1
    fi
fi
