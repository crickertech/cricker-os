#!/bin/sh
# pre-push: the formatting gate, lint's text checks, and the ready-status check, run where they are cheap.
#
# CI's rustfmt is one of seven required checks, and a lane that pushes unformatted code learns
# that from a runner ten minutes later, then pushes again. Every lane on 2026-08-15 and -16 paid
# that tax at least once, three of them on the same night, which is a gate teaching the wrong
# lesson: "run CI to find out how to format". This runs the identical check in about 2 s before the
# push leaves the machine.
#
# What this runs, and what it skips (milestone 729 (the pre-push hook runs what fits in seconds), provisional, 2026-10-03 UTC; calef approved
# COE decision 3 on #1564: "Approve the revised decision 3."):
#
#   1. `script/fmt --check`.
#   2. `script/lint --no-cargo`: every lint check that does not invoke cargo. Clippy stays in CI.
#   3. `script/roadmap --ready-branch`, for a branch whose pull request is ready.
#   4. All three are skipped for a push whose commits change no files, which is a claim (an empty
#      commit, §90 (the claim is a draft pull request)). That push used to be refused for "milestone N has no roadmap
#      block", five false refusals on 2026-10-03, because the block comes after the claim.
#
# How it got here. The hook grew one gate per incident (clippy on 2026-09-29, then the prose
# ratchets, then the baselines check), each after a lane lost a queue cycle, and the list lagged
# every time. Milestone 630 (a merge-queue ejection is caught before the queue, and recovered
# after it) then made it all of `script/lint`, which on 2026-10-03 cost 70 to 120 s warm and 202 s
# cold on a loaded machine, past an agent harness's two-minute tool limit. #1556's claim push sat
# in it for a whole lane, #1560's first push timed out, and lanes took to `--no-verify`, which is
# a gate teaching the wrong lesson again. Of the 38 lint failures CI saw on pull requests between
# 2026-09-19 and 10-03 under an fmt-only hook, 36 came from checks that read text, so the text
# checks are the ones worth the seconds. The measured cost of this version is in notes/scripts.md.
#
# "Not cargo" is a rule and not a list: `script/lint --no-cargo` reads the partition out of
# script/lint's own sections (helpers/lint-no-cargo.awk), so a new check is in a bucket the moment
# it is written. `script/lint --no-cargo --list` prints which sections run. The design record is
# the COE for 2026-10-03, notes/coes/2026-10-03-the-queue-judged-one-pull-request-at-a-time.md.
#
# Installed by `script/setup` via core.hooksPath, so it covers every worktree sharing this .git
# (which is how lanes work) rather than needing per-worktree installation.
#
# `NIFE_PUSH_QUEUED=1 git push` overrides only the queued-branch check. Bypass with `git push --no-verify` when you mean it: pushing a work-in-progress branch for
# safekeeping is a legitimate reason, and this hook is a courtesy to the queue rather than a
# rule about what may exist on a branch.

root="$(git rev-parse --show-toplevel)"
[ -x "$root/script/fmt" ] || exit 0   # a branch predating the script pushes unimpeded

# git sends one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>. Read it
# once, because two steps below want it.
refs="$(cat)"

# **A push to a branch whose pull request is in the merge queue is refused** (provisional milestone
# name: refuse a push to a queued branch, 2026-10-05 UTC). It runs before the empty-push skip below
# because an empty push to a queued branch removes it from the queue just as well. One `gh api
# graphql` call, fail-open with a one-line warning when `gh` cannot answer. Override with
# `NIFE_PUSH_QUEUED=1` (provisional name). helpers/push-queued-check.sh has the reasoning and
# notes/merge-queue.md has the measurement.
if [ -x "$root/helpers/push-queued-check.sh" ]; then
    printf '%s\n' "$refs" | "$root/helpers/push-queued-check.sh" || exit 1
fi

# **A push that changes no files has nothing to check** (a claim: `git commit --allow-empty`). Changed
# is measured against the remote ref when it exists, and against where the branch left origin/main
# when it is new, so a claim is the same empty push the first time and every time. A deletion pushes
# no files. Any case this cannot answer (a remote sha this clone has never fetched) counts as
# changed, so the answer errs toward checking and never skips a push that carries files.
zero=0000000000000000000000000000000000000000
changed=
while read -r _ local_sha _ remote_sha; do
    [ -n "$local_sha" ] || continue
    [ "$local_sha" != "$zero" ] || continue
    if [ "$remote_sha" = "$zero" ]; then
        base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || base=
    else
        base="$remote_sha"
    fi
    if [ -z "$base" ] || ! git diff --quiet "$base" "$local_sha" 2>/dev/null; then
        changed=1
    fi
done <<ENDREFS
$refs
ENDREFS
[ -n "$changed" ] || exit 0

if ! "$root/script/fmt" --check >/dev/null 2>&1; then
    echo "pre-push: rustfmt would change files, and CI's rustfmt check will fail." >&2
    echo "  Fix:    script/fmt        (then commit and push again)" >&2
    echo "  Bypass: git push --no-verify" >&2
    exit 1
fi

# **git exports GIT_DIR to a hook, and lint must not inherit it** (found by this lane, 2026-10-03).
# Inside a hook GIT_DIR names this worktree's git directory, so any check that `cd`s into a
# throwaway repository and runs git there acts on the real one instead.
# helpers/scope-merge-base-selftest.sh did exactly that on this hook's first full run: its `git init`
# set `core.bare = true` and its `git config` set a fake user.name and user.email in the shared
# `.git/config`, under every worktree on the machine, before `git checkout -b main` failed. Both were
# put back by hand. The checks find the repository from their own working directory, which is what
# a person running `script/lint` gets, so clearing the hook's git environment is the whole fix.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_CONFIG_PARAMETERS
out="$(mktemp "${TMPDIR:-/tmp}/nife-pre-push.XXXXXX")"
if ! "$root/script/lint" --no-cargo >"$out" 2>&1; then
    echo "pre-push: script/lint --no-cargo failed; CI runs these checks too and will fail the same way." >&2
    tail -n 15 "$out" | sed 's/^/  | /' >&2
    echo "  Fix:    script/lint --no-cargo   (read its output, fix, commit, push again)" >&2
    echo "  Bypass: git push --no-verify" >&2
    rm -f "$out"
    exit 1
fi
rm -f "$out"

# **A ready pull request may not carry an IN-PROGRESS block on its own branch** (milestone 630).
# The same question `.github/workflows/ready-status.yml` asks on `pull_request`, asked here for a
# push to a branch whose pull request is already ready, so the answer comes before the push rather
# than a runner later. The merge group's roadmap check fails on exactly this 20 to 38 minutes into
# a queue attempt, and the ejection cancels auto-merge (#1473, 2026-10-03).
#
# The branch is the one being pushed, from stdin (`<local ref> <sha> <remote ref> <sha>`), not
# HEAD's. It needs `gh` and the network; with neither, or with no pull request, or a draft, it
# skips silently, because a draft's block is honest to say IN-PROGRESS and CI asks again anyway.
# The block is read from the working tree, as lint's is.
if [ -x "$root/script/roadmap" ] && grep -q -- '"--ready-branch"' "$root/script/roadmap" 2>/dev/null &&
    command -v gh >/dev/null 2>&1; then
    while read -r _ _ remote_ref _; do
        case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
        branch="${remote_ref#refs/heads/}"
        draft="$(gh pr view "$branch" --json isDraft -q .isDraft 2>/dev/null || true)"
        [ "$draft" = "false" ] || continue
        if ! "$root/script/roadmap" --ready-branch "$branch"; then
            echo "pre-push: the pull request for $branch is ready, and its block above still reads IN-PROGRESS." >&2
            echo "  Bypass: git push --no-verify" >&2
            exit 1
        fi
    done <<ENDREFS
$refs
ENDREFS
fi
